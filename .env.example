# ═══ StarNova — Environment Variables (Vercel → Settings → Env) ═══

# Domain tunggal untuk semuanya (landing + dashboard + api). WAJIB.
NEXT_PUBLIC_SITE_URL=https://starnova.my.id
NEXTAUTH_URL=https://starnova.my.id
NEXTAUTH_SECRET=ganti-string-acak-panjang-min-32-char

# Database — MongoDB Atlas (WAJIB untuk auth & apikey)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/starnova?retryWrites=true&w=majority

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://starnova.my.id/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Demo login (tanpa Google). Set "false" di produksi bila hanya mau Google.
ALLOW_DEMO_LOGIN=true

# Admin (comma-separated) — email ini otomatis jadi admin saat login.
ADMIN_EMAILS=admin@starnova.my.id

CREATOR=StarNova API
