# ═══════════════════════════════════════════════════════════
#  StarNova — Environment Variables
#  Salin file ini jadi `.env.local` (lokal) ATAU isi di
#  Vercel → Project → Settings → Environment Variables (produksi).
# ═══════════════════════════════════════════════════════════

# ── 1) DOMAIN (WAJIB) ──
# Satu domain untuk semuanya (landing + dashboard + api).
# Lokal: http://localhost:3000  |  Produksi: https://domainmu.com
NEXT_PUBLIC_SITE_URL=https://starnova.my.id
NEXTAUTH_URL=https://starnova.my.id

# ── 2) SECRET (WAJIB) ──
# String acak minimal 32 karakter. Generate: `openssl rand -base64 32`
NEXTAUTH_SECRET=ganti-dengan-hasil-openssl-rand-base64-32

# ── 3) DATABASE (WAJIB) ──
# MongoDB Atlas (gratis) — lihat panduan di README.
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/starnova?retryWrites=true&w=majority

# ── 4) GOOGLE OAUTH (WAJIB — login default) ──
# Dari Google Cloud Console → Credentials → OAuth client ID (Web).
# Authorized redirect URI: https://domainmu.com/api/auth/callback/google
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# ── 5) ADMIN (opsional) ──
# Admin default sudah: starnovabusinessmail@gmail.com
# Tambah admin lain (comma-separated) bila perlu:
ADMIN_EMAILS=

# ── 6) DEMO LOGIN (opsional) ──
# Login tanpa Google untuk testing lokal. Biarkan kosong/false di produksi.
ALLOW_DEMO_LOGIN=false

# ── 7) Branding (opsional) ──
CREATOR=StarNova API

# ── 8) TERABOX (opsional, untuk endpoint /api/v1/download/terabox) ──
# Terabox WAJIB cookie akun agar stabil (tanpa ini balikan "need verify_v2"
# & API publik gratisan sering mati). Ambil cookie dari browser (login Terabox):
# buka DevTools → Application → Cookies → salin seluruh cookie (minimal berisi 'ndus=...').
# Format: satu baris "key1=val1; key2=val2; ndus=xxxx".
# Tanpa ini, endpoint tetap jalan tapi mengandalkan API publik (bisa gagal).
TERABOX_COOKIE=
